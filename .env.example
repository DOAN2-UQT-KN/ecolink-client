# Copy to .env for local dev ( .env is gitignored )
VITE_API_URL=http://localhost:8081
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
# Goong keys: account.goong.io (maptiles key + REST API key); restrict both by domain
VITE_GOONG_MAPTILES_KEY=your_goong_maptiles_key
VITE_GOONG_API_KEY=your_goong_api_key
